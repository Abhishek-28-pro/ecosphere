// EcoSphere.AI - Multi-Tenant Enterprise Schema
// Supports PostgreSQL with pgvector extension for high-dimensional semantic search

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  admin
  agent
}

enum Channel {
  widget
  email
  chat
}

enum ConversationStatus {
  active
  escalated
  resolved
  closed
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum SenderType {
  customer
  ai
  agent
}

enum Visibility {
  public
  internal
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  plan          String         @default("starter")
  createdAt     DateTime       @default(now()) @map("created_at")
  users         User[]
  customers     Customer[]
  conversations Conversation[]
  tickets       Ticket[]
  kbArticles    KBArticle[]
  kbEmbeddings  KBEmbedding[]
  csatRatings   CSATRating[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String
  passwordHash String    @map("password_hash")
  name         String
  role         Role      @default(agent)
  createdAt    DateTime  @default(now()) @map("created_at")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTickets Ticket[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Customer {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  externalId    String?        @map("external_id")
  name          String
  email         String
  createdAt     DateTime       @default(now()) @map("created_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tickets       Ticket[]

  @@index([tenantId, email])
  @@map("customers")
}

model Conversation {
  id          String             @id @default(uuid())
  tenantId    String             @map("tenant_id")
  customerId  String             @map("customer_id")
  channel     Channel            @default(widget)
  status      ConversationStatus @default(active)
  createdAt   DateTime           @default(now()) @map("created_at")
  closedAt    DateTime?          @map("closed_at")
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages    Message[]
  tickets     Ticket[]

  @@index([tenantId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  sender         SenderType
  content        String
  citations      Json?        @map("citations")
  isInternal     Boolean      @default(false) @map("is_internal")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Ticket {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  conversationId   String         @map("conversation_id")
  customerId       String         @map("customer_id")
  assignedAgentId  String?        @map("assigned_agent_id")
  subject          String
  summary          String
  status           TicketStatus   @default(open)
  priority         TicketPriority @default(medium)
  category         String         @default("General")
  sentimentScore   Float          @default(0.0) @map("sentiment_score")
  sentimentLabel   String         @default("neutral") @map("sentiment_label")
  aiSuggestedReply String?        @map("ai_suggested_reply")
  createdAt        DateTime       @default(now()) @map("created_at")
  resolvedAt       DateTime?      @map("resolved_at")
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent    User?          @relation(fields: [assignedAgentId], references: [id])
  csatRatings      CSATRating[]

  @@index([tenantId, status])
  @@index([tenantId, assignedAgentId])
  @@map("tickets")
}

model KBArticle {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  title      String
  slug       String
  body       String
  category   String        @default("General")
  visibility Visibility    @default(public)
  version    Int           @default(1)
  updatedAt  DateTime      @updatedAt @map("updated_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  embeddings KBEmbedding[]

  @@index([tenantId])
  @@map("kb_articles")
}

model KBEmbedding {
  id         String                    @id @default(uuid())
  tenantId   String                    @map("tenant_id")
  articleId  String                    @map("article_id")
  chunkText  String                    @map("chunk_text")
  embedding  Unsupported("vector(768)") // 768-dim vector for Gemini or Claude embeddings
  createdAt  DateTime                  @default(now()) @map("created_at")
  tenant     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article    KBArticle                 @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("kb_embeddings")
}

model CSATRating {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  ticketId  String   @map("ticket_id")
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("csat_ratings")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  actorId    String   @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  target     String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
