# Environment Configuration for EcoSphere.AI
# All AI calls and secrets are BACKEND-ONLY. Never exposed to browser bundles.

# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL="file:./ecosphere.db"

# AI Provider API Keys (Backend-only)
GEMINI_API_KEY="your-google-gemini-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
AI_PROVIDER="gemini" # "gemini" | "anthropic" | "mock"
AI_MODEL="gemini-1.5-pro"

# Authentication Secrets
JWT_ACCESS_SECRET="ecosphere-super-secret-jwt-access-key-production-strength-32chars"
JWT_REFRESH_SECRET="ecosphere-super-secret-jwt-refresh-key-production-strength-32chars"

# Object Storage for File Attachments (S3 / R2 compatible)
OBJECT_STORAGE_BUCKET="ecosphere-attachments"
OBJECT_STORAGE_KEY="your-storage-key"
OBJECT_STORAGE_SECRET="your-storage-secret"

# Transactional Email Provider
EMAIL_PROVIDER_API_KEY="your-email-provider-key"

# App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
